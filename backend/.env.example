# ============================================================
# NEW Campus Grievance Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

PORT=5001
NODE_ENV=development

# NEW MongoDB Atlas connection string — NOT the old project's DB
MONGODB_URI=your_new_mongodb_atlas_connection_string
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

# JWT — generate a strong random secret (min 32 chars)
JWT_SECRET=your_new_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# PSG Campus location (Haversine mode)
CAMPUS_LATITUDE=11.0238
CAMPUS_LONGITUDE=77.0066
CAMPUS_RADIUS_METERS=800
LOCATION_MODE=radius

# Image upload
IMAGE_MAX_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
UPLOAD_STORAGE=local

# AI image validation (set AI_ENABLED=false to skip, use mock)
AI_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=qwen2.5vl:3b
AI_BASE_URL=http://localhost:11434
AI_TIMEOUT_MS=60000
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here

# CORS — comma-separated allowed origins
FRONTEND_URL=http://localhost:3000,http://localhost:5173
